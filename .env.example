# Copy to .env and fill in. .env is gitignored. NEVER commit real keys.

# --- Alpaca PAPER keys (https://app.alpaca.markets -> Paper Trading -> API Keys) ---
# The system refuses to start unless the trading host resolves to paper-api.alpaca.markets.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
EXECUTION_ENABLED=false

# Optional 2nd paper account for the "baseline" lane (experiment E1: rule strategy vs agent).
ALPACA_BASELINE_KEY_ID=
ALPACA_BASELINE_SECRET_KEY=

# --- LLM: the model is an INPUT. Profiles live in config/llm_profiles.yaml ---
# Name of the profile used by the live agent (can be switched at runtime: tradectl set-model live <profile>)
LLM_PROFILE_LIVE=primary
# Optional shadow variant used for experiment E2 (leave empty to disable)
LLM_PROFILE_SHADOW=

# API keys referenced by api_key_env in llm_profiles.yaml (add whichever your profiles use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# For local/open-source servers (Ollama, vLLM, LM Studio) a dummy value is fine, e.g. "ollama"
LOCAL_LLM_API_KEY=ollama

# --- Infra (defaults work with docker compose) ---
# APP_PORT=8765  # Optional localhost UI port for compose.app.yml.
POSTGRES_PASSWORD=trader
# Host port for Postgres (only used by host-side `tradectl`; containers use the compose network).
# 5442, not 5432, so it does not collide with other local Postgres containers.
# Optional: a Discord or Slack incoming-webhook URL. Halts, watchdog actions and unknown order outcomes are pushed there.
ALERT_WEBHOOK_URL=
# Optional dead-man URL (e.g. healthchecks.io): pinged every watchdog loop, so its silence alerts you if the watchdog dies.
WATCHDOG_PING_URL=
POSTGRES_HOST_PORT=5442

# Finite paper-proof run; the supervisor selects future sessions from Alpaca's calendar.
REALTIME_ENABLED=false
MANAGED_PAPER_ENABLED=false
TRADER_RUN_DIR=/app/proof/paper-run-current
TRADER_RUN_SESSIONS=5
