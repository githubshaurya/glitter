# Save real values in .env beside this file. Never commit .env.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
GROQ_API_KEY=
# Hard-coded paper broker host; this value is checked, never used for arbitrary routing.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Local persistent file, or PostgreSQL / Supabase DIRECT or SESSION pooler URL.
# Example: postgresql+psycopg://postgres:password@localhost:5432/glitter
# For hosted PostgreSQL append ?sslmode=require. Do NOT use transaction pooler :6543.
DATABASE_URL=sqlite:///./data/glitter.db
# Generate a private password/token for the dashboard; no default password is provided.
DASHBOARD_TOKEN=
# Read-only until explicitly enabled. All execution is PAPER even when true.
EXECUTION_ENABLED=false
# Explicitly enable only after consenting to send private balances/positions/orders to Groq.
AGENT_ACCOUNT_CONTEXT_ENABLED=false
GROQ_MODEL=openai/gpt-oss-120b
GROQ_COMPARISON_MODEL=openai/gpt-oss-20b
REASONING_EFFORT=medium
HOST=127.0.0.1
PORT=8000
POLL_SECONDS=900
MAX_ORDER_FRACTION=0.01
MAX_SYMBOL_FRACTION=0.02
MAX_TOTAL_FRACTION=0.04
MAX_DAILY_LOSS=0.01
MAX_DRAWDOWN=0.02
MAX_SPREAD_BPS=50
MAX_ENTRIES_PER_DAY=2
# Optional reporting/experiment window, ISO8601 UTC; otherwise use journal window.
REPORT_START=
REPORT_END=
REPORT_DIRECTORY=reports/latest
EXPERIMENT_LIMIT=100
RUN_PORTFOLIO_REPLAY=false
SIMULATED_FEE_BPS=25
SIMULATED_SLIPPAGE_BPS=5
